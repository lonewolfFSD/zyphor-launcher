{
  "name": "stay-launcher",
  "productName": "Zyphor Launcher",
  "version": "1.3.6",
  "description": "Official desktop launcher for all Zyphor Studios titles.",
  "author": "Zyphor Studios",
  "license": "UNLICENSED",
  "private": true,
  "main": "electron/main.js",
  "type": "commonjs",
  "scripts": {
    "dev": "concurrently -k -n VITE,ELECTRON -c cyan,magenta \"vite\" \"npm run electron:wait\"",
    "electron:wait": "wait-on tcp:5173 && cross-env NODE_ENV=development electron .",
    "build": "vite build",
    "start": "npm run build && electron .",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "release": "dotenv -e .env -- electron-builder --publish always"
  },
  "dependencies": {
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@gsap/react": "^2.1.2",
    "@tailwindcss/typography": "^0.5.20",
    "@xenova/transformers": "^2.17.2",
    "electron-updater": "^6.8.9",
    "ffmpeg-static": "^5.3.0",
    "firebase": "^12.17.0",
    "firebase-admin": "^14.2.0",
    "framer-motion": "^12.43.0",
    "gsap": "^3.15.0",
    "lucide-react": "^1.28.0",
    "ogl": "^1.0.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "screenshot-desktop": "^1.15.4",
    "sharp": "^0.35.3",
    "steamworks.js": "^0.4.0",
    "tesseract.js": "^7.0.0",
    "three": "^0.185.1",
    "winreg": "^1.2.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "dotenv-cli": "^11.0.0",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^5.4.11",
    "wait-on": "^8.0.1"
  },
  "nsis": {
    "include": "build/installer.nsh"
  },
  "build": {
    "appId": "com.zyphorstudios.zyphorlauncher",
    "productName": "Zyphor Launcher",
    "directories": {
      "output": "release",
      "buildResources": "build-resources"
    },
    "publish": {
      "provider": "github",
      "owner": "lonewolfFSD",
      "repo": "zyphor-launcher"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "config/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "game",
        "to": "game",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "electron/resources/ollama.exe",
        "to": "ollama.exe"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build-resources/icons/win/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "build-resources/icons/mac/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build-resources/icons/linux/icon.png"
    }
  }
}
