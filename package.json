{
  "name": "stay-launcher",
  "productName": "Zyphor Launcher",
  "version": "1.0.0",
  "description": "Official desktop launcher for STAY: Chapter One - The Jar Theory",
  "author": "LonewolfFSD",
  "license": "UNLICENSED",
  "private": true,
  "main": "electron/main.js",
  "type": "commonjs",
  "scripts": {
    "dev": "concurrently -k -n VITE,ELECTRON -c cyan,magenta \"vite\" \"npm run electron:wait\"",
    "electron:wait": "wait-on tcp:5173 && cross-env NODE_ENV=development electron .",
    "build": "vite build",
    "start": "npm run build && electron .",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "firebase": "^12.17.0",
    "framer-motion": "^12.43.0",
    "lucide-react": "^1.28.0",
    "ogl": "^1.0.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "vite": "^5.4.11",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.lonewolffsd.zyphorlauncher",
    "productName": "Zyphor Launcher",
    "directories": {
      "output": "release",
      "buildResources": "build-resources"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "config/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "game",
        "to": "game",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build-resources/icons/win/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "build-resources/icons/mac/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build-resources/icons/linux/icon.png"
    }
  }
}
